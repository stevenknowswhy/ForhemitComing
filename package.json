{
  "name": "forhemit-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:eslint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "turbo test",
    "test:ci": "vitest run --reporter=verbose",
    "convex:dev": "pnpm --filter @forhemit/convex run convex:dev",
    "convex:deploy": "pnpm --filter @forhemit/convex run convex:deploy",
    "convex:once": "pnpm --filter @forhemit/convex run convex:once"
  },
  "devDependencies": {
    "next": "^15.3.3",
    "turbo": "^2.9.4"
  }
}
